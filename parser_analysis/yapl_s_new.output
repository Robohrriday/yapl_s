Grammar

    0 $accept: translation_unit $end

    1 primary_expression: IDENTIFIER
    2                   | constant
    3                   | string
    4                   | '(' expression ')'
    5                   | generic_selection
    6                   | f_string_expression

    7 f_string_expression: FSTRING_START f_string_body FSTRING_END

    8 f_string_body: ε
    9              | f_string_body STRING_LITERAL_PART
   10              | f_string_body interpolation_block

   11 interpolation_block: INTERPOLATION_START expression INTERPOLATION_END

   12 constant: I_CONSTANT
   13         | F_CONSTANT
   14         | ENUMERATION_CONSTANT

   15 enumeration_constant: IDENTIFIER

   16 string: STRING_LITERAL
   17       | FUNC_NAME

   18 generic_selection: GENERIC '(' assignment_expression ',' generic_assoc_list ')'

   19 generic_assoc_list: generic_association
   20                   | generic_assoc_list ',' generic_association

   21 generic_association: type_name ':' assignment_expression
   22                    | DEFAULT ':' assignment_expression

   23 postfix_expression: primary_expression
   24                   | postfix_expression '[' expression ']'
   25                   | postfix_expression '(' ')'
   26                   | postfix_expression '(' argument_expression_list ')'
   27                   | postfix_expression '.' IDENTIFIER
   28                   | postfix_expression PTR_OP IDENTIFIER
   29                   | postfix_expression INC_OP
   30                   | postfix_expression DEC_OP
   31                   | '(' type_name ')' '{' initializer_list '}'
   32                   | '(' type_name ')' '{' initializer_list ',' '}'

   33 argument_expression_list: assignment_expression
   34                         | argument_expression_list ',' assignment_expression

   35 unary_expression: postfix_expression
   36                 | INC_OP unary_expression
   37                 | DEC_OP unary_expression
   38                 | unary_operator cast_expression
   39                 | SIZEOF unary_expression
   40                 | SIZEOF '(' type_name ')'
   41                 | ALIGNOF '(' type_name ')'

   42 unary_operator: '&'
   43               | '*'
   44               | '+'
   45               | '-'
   46               | '~'
   47               | '!'

   48 cast_expression: unary_expression
   49                | '(' type_name ')' cast_expression

   50 multiplicative_expression: cast_expression
   51                          | multiplicative_expression '*' cast_expression
   52                          | multiplicative_expression '/' cast_expression
   53                          | multiplicative_expression '%' cast_expression

   54 additive_expression: multiplicative_expression
   55                    | additive_expression '+' multiplicative_expression
   56                    | additive_expression '-' multiplicative_expression

   57 shift_expression: additive_expression
   58                 | shift_expression LEFT_OP additive_expression
   59                 | shift_expression RIGHT_OP additive_expression

   60 concatenation_expression: shift_expression
   61                         | concatenation_expression '@' shift_expression

   62 relational_expression: concatenation_expression
   63                      | relational_expression '<' concatenation_expression
   64                      | relational_expression '>' concatenation_expression
   65                      | relational_expression LE_OP concatenation_expression
   66                      | relational_expression GE_OP concatenation_expression
   67                      | relational_expression TH_OP concatenation_expression

   68 equality_expression: relational_expression
   69                    | equality_expression EQ_OP relational_expression
   70                    | equality_expression NE_OP relational_expression

   71 and_expression: equality_expression
   72               | and_expression '&' equality_expression

   73 exclusive_or_expression: and_expression
   74                        | exclusive_or_expression '^' and_expression

   75 inclusive_or_expression: exclusive_or_expression
   76                        | inclusive_or_expression '|' exclusive_or_expression

   77 logical_and_expression: inclusive_or_expression
   78                       | logical_and_expression AND_OP inclusive_or_expression

   79 logical_or_expression: logical_and_expression
   80                      | logical_or_expression OR_OP logical_and_expression

   81 conditional_expression: logical_or_expression

   82 assignment_expression: conditional_expression
   83                      | unary_expression assignment_operator assignment_expression

   84 assignment_operator: '='
   85                    | MUL_ASSIGN
   86                    | DIV_ASSIGN
   87                    | MOD_ASSIGN
   88                    | ADD_ASSIGN
   89                    | SUB_ASSIGN
   90                    | LEFT_ASSIGN
   91                    | RIGHT_ASSIGN
   92                    | AND_ASSIGN
   93                    | XOR_ASSIGN
   94                    | OR_ASSIGN

   95 expression: assignment_expression
   96           | expression ',' assignment_expression

   97 constant_expression: conditional_expression

   98 declaration: declaration_specifiers ';'
   99            | declaration_specifiers init_declarator_list ';'
  100            | static_assert_declaration

  101 declaration_specifiers: storage_class_specifier declaration_specifiers
  102                       | storage_class_specifier
  103                       | type_specifier declaration_specifiers
  104                       | type_specifier
  105                       | type_qualifier declaration_specifiers
  106                       | type_qualifier
  107                       | function_specifier declaration_specifiers
  108                       | function_specifier
  109                       | alignment_specifier declaration_specifiers
  110                       | alignment_specifier

  111 init_declarator_list: init_declarator
  112                     | init_declarator_list ',' init_declarator

  113 init_declarator: declarator '=' initializer
  114                | declarator

  115 storage_class_specifier: TYPEDEF
  116                        | EXTERN
  117                        | STATIC
  118                        | THREAD_LOCAL
  119                        | AUTO
  120                        | REGISTER

  121 type_specifier: VOID
  122               | CHAR
  123               | SHORT
  124               | INT
  125               | LONG
  126               | FLOAT
  127               | DOUBLE
  128               | SIGNED
  129               | UNSIGNED
  130               | BOOL
  131               | COMPLEX
  132               | IMAGINARY
  133               | atomic_type_specifier
  134               | struct_or_union_specifier
  135               | enum_specifier
  136               | TYPEDEF_NAME

  137 struct_or_union_specifier: struct_or_union '{' struct_declaration_list '}'
  138                          | struct_or_union IDENTIFIER '{' struct_declaration_list '}'
  139                          | struct_or_union IDENTIFIER

  140 struct_or_union: STRUCT
  141                | UNION

  142 struct_declaration_list: struct_declaration
  143                        | struct_declaration_list struct_declaration

  144 struct_declaration: specifier_qualifier_list ';'
  145                   | specifier_qualifier_list struct_declarator_list ';'
  146                   | static_assert_declaration

  147 specifier_qualifier_list: type_specifier specifier_qualifier_list
  148                         | type_specifier
  149                         | type_qualifier specifier_qualifier_list
  150                         | type_qualifier

  151 struct_declarator_list: struct_declarator
  152                       | struct_declarator_list ',' struct_declarator

  153 struct_declarator: ':' constant_expression
  154                  | declarator ':' constant_expression
  155                  | declarator

  156 enum_specifier: ENUM '{' enumerator_list '}'
  157               | ENUM '{' enumerator_list ',' '}'
  158               | ENUM IDENTIFIER '{' enumerator_list '}'
  159               | ENUM IDENTIFIER '{' enumerator_list ',' '}'
  160               | ENUM IDENTIFIER

  161 enumerator_list: enumerator
  162                | enumerator_list ',' enumerator

  163 enumerator: enumeration_constant '=' constant_expression
  164           | enumeration_constant

  165 atomic_type_specifier: ATOMIC '(' type_name ')'

  166 type_qualifier: CONST
  167               | RESTRICT
  168               | VOLATILE
  169               | ATOMIC

  170 function_specifier: INLINE
  171                   | NORETURN

  172 alignment_specifier: ALIGNAS '(' type_name ')'
  173                    | ALIGNAS '(' constant_expression ')'

  174 declarator: pointer direct_declarator
  175           | direct_declarator

  176 direct_declarator: IDENTIFIER
  177                  | '(' declarator ')'
  178                  | direct_declarator '[' ']'
  179                  | direct_declarator '[' '*' ']'
  180                  | direct_declarator '[' STATIC type_qualifier_list assignment_expression ']'
  181                  | direct_declarator '[' STATIC assignment_expression ']'
  182                  | direct_declarator '[' type_qualifier_list '*' ']'
  183                  | direct_declarator '[' type_qualifier_list STATIC assignment_expression ']'
  184                  | direct_declarator '[' type_qualifier_list assignment_expression ']'
  185                  | direct_declarator '[' type_qualifier_list ']'
  186                  | direct_declarator '[' assignment_expression ']'
  187                  | direct_declarator '(' parameter_type_list ')'
  188                  | direct_declarator '(' ')'
  189                  | direct_declarator '(' identifier_list ')'

  190 pointer: '*' type_qualifier_list pointer
  191        | '*' type_qualifier_list
  192        | '*' pointer
  193        | '*'

  194 type_qualifier_list: type_qualifier
  195                    | type_qualifier_list type_qualifier

  196 parameter_type_list: parameter_list ',' ELLIPSIS
  197                    | parameter_list

  198 parameter_list: parameter_declaration
  199               | parameter_list ',' parameter_declaration

  200 parameter_declaration: declaration_specifiers declarator
  201                      | declaration_specifiers abstract_declarator
  202                      | declaration_specifiers

  203 identifier_list: IDENTIFIER
  204                | identifier_list ',' IDENTIFIER

  205 type_name: specifier_qualifier_list abstract_declarator
  206          | specifier_qualifier_list

  207 abstract_declarator: pointer direct_abstract_declarator
  208                    | pointer
  209                    | direct_abstract_declarator

  210 direct_abstract_declarator: '(' abstract_declarator ')'
  211                           | '[' ']'
  212                           | '[' '*' ']'
  213                           | '[' STATIC type_qualifier_list assignment_expression ']'
  214                           | '[' STATIC assignment_expression ']'
  215                           | '[' type_qualifier_list STATIC assignment_expression ']'
  216                           | '[' type_qualifier_list assignment_expression ']'
  217                           | '[' type_qualifier_list ']'
  218                           | '[' assignment_expression ']'
  219                           | direct_abstract_declarator '[' ']'
  220                           | direct_abstract_declarator '[' '*' ']'
  221                           | direct_abstract_declarator '[' STATIC type_qualifier_list assignment_expression ']'
  222                           | direct_abstract_declarator '[' STATIC assignment_expression ']'
  223                           | direct_abstract_declarator '[' type_qualifier_list assignment_expression ']'
  224                           | direct_abstract_declarator '[' type_qualifier_list STATIC assignment_expression ']'
  225                           | direct_abstract_declarator '[' type_qualifier_list ']'
  226                           | direct_abstract_declarator '[' assignment_expression ']'
  227                           | '(' ')'
  228                           | '(' parameter_type_list ')'
  229                           | direct_abstract_declarator '(' ')'
  230                           | direct_abstract_declarator '(' parameter_type_list ')'

  231 initializer: '{' initializer_list '}'
  232            | '{' initializer_list ',' '}'
  233            | assignment_expression

  234 initializer_list: designation initializer
  235                 | initializer
  236                 | initializer_list ',' designation initializer
  237                 | initializer_list ',' initializer

  238 designation: designator_list '='

  239 designator_list: designator
  240                | designator_list designator

  241 designator: '[' constant_expression ']'
  242           | '.' IDENTIFIER

  243 static_assert_declaration: STATIC_ASSERT '(' constant_expression ',' STRING_LITERAL ')' ';'

  244 statement: labeled_statement
  245          | compound_statement
  246          | expression_statement
  247          | selection_statement
  248          | iteration_statement
  249          | jump_statement

  250 labeled_statement: IDENTIFIER ':' statement
  251                  | CASE constant_expression ':' statement
  252                  | DEFAULT ':' statement

  253 compound_statement: '{' '}'
  254                   | '{' block_item_list '}'

  255 block_item_list: block_item
  256                | block_item_list block_item

  257 block_item: declaration
  258           | statement

  259 expression_statement: ';'
  260                     | expression ';'

  261 $@1: ε

  262 selection_statement: IF '(' expression ')' statement ELSE $@1 statement
  263                    | IF '(' expression ')' statement
  264                    | SWITCH '(' expression ')' statement

  265 iteration_statement: WHILE '(' expression ')' statement
  266                    | DO statement WHILE '(' expression ')' ';'
  267                    | FOR '(' expression_statement expression_statement ')' statement
  268                    | FOR '(' expression_statement expression_statement expression ')' statement
  269                    | FOR '(' declaration expression_statement ')' statement
  270                    | FOR '(' declaration expression_statement expression ')' statement

  271 jump_statement: GOTO IDENTIFIER ';'
  272               | CONTINUE ';'
  273               | BREAK ';'
  274               | RETURN ';'
  275               | RETURN expression ';'

  276 translation_unit: external_declaration
  277                 | translation_unit external_declaration

  278 external_declaration: function_definition
  279                     | declaration

  280 function_definition: declaration_specifiers declarator declaration_list compound_statement
  281                    | declaration_specifiers declarator compound_statement

  282 declaration_list: declaration
  283                 | declaration_list declaration


