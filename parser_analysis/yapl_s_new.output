Grammar

    0 $accept: translation_unit $end

    1 primary_expression: IDENTIFIER
    2                   | constant
    3                   | string
    4                   | '(' expression ')'
    5                   | f_string_expression

    6 f_string_expression: FSTRING_START f_string_body FSTRING_END

    7 f_string_body: ε
    8              | f_string_body STRING_LITERAL_PART
    9              | f_string_body interpolation_block

   10 interpolation_block: INTERPOLATION_START expression INTERPOLATION_END

   11 $@1: ε

   12 constant: I_CONSTANT $@1
   13         | F_CONSTANT

   14 string: STRING_LITERAL

   15 postfix_expression: primary_expression
   16                   | postfix_expression '[' expression ']'
   17                   | postfix_expression '(' ')'
   18                   | postfix_expression '(' argument_expression_list ')'
   19                   | postfix_expression '.' IDENTIFIER
   20                   | postfix_expression PTR_OP IDENTIFIER
   21                   | postfix_expression INC_OP
   22                   | postfix_expression DEC_OP
   23                   | '(' type_name ')' '{' initializer_list '}'
   24                   | '(' type_name ')' '{' initializer_list ',' '}'

   25 argument_expression_list: assignment_expression
   26                         | argument_expression_list ',' assignment_expression

   27 unary_expression: postfix_expression
   28                 | INC_OP unary_expression
   29                 | DEC_OP unary_expression
   30                 | unary_operator cast_expression
   31                 | SIZEOF unary_expression
   32                 | SIZEOF '(' type_name ')'

   33 unary_operator: '&'
   34               | '*'
   35               | '+'
   36               | '-'
   37               | '~'
   38               | '!'

   39 cast_expression: unary_expression
   40                | '(' type_name ')' cast_expression

   41 multiplicative_expression: cast_expression
   42                          | multiplicative_expression '*' cast_expression
   43                          | multiplicative_expression '/' cast_expression
   44                          | multiplicative_expression '%' cast_expression

   45 additive_expression: multiplicative_expression
   46                    | additive_expression '+' multiplicative_expression
   47                    | additive_expression '-' multiplicative_expression

   48 shift_expression: additive_expression

   49 concatenation_expression: shift_expression
   50                         | concatenation_expression '@' shift_expression

   51 relational_expression: concatenation_expression
   52                      | relational_expression '<' concatenation_expression
   53                      | relational_expression '>' concatenation_expression
   54                      | relational_expression LE_OP concatenation_expression
   55                      | relational_expression GE_OP concatenation_expression
   56                      | relational_expression TH_OP concatenation_expression

   57 equality_expression: relational_expression
   58                    | equality_expression EQ_OP relational_expression
   59                    | equality_expression NE_OP relational_expression

   60 and_expression: equality_expression
   61               | and_expression '&' equality_expression

   62 exclusive_or_expression: and_expression
   63                        | exclusive_or_expression '^' and_expression

   64 inclusive_or_expression: exclusive_or_expression
   65                        | inclusive_or_expression '|' exclusive_or_expression

   66 logical_and_expression: inclusive_or_expression
   67                       | logical_and_expression AND_OP inclusive_or_expression

   68 logical_or_expression: logical_and_expression
   69                      | logical_or_expression OR_OP logical_and_expression

   70 conditional_expression: logical_or_expression

   71 assignment_expression: conditional_expression
   72                      | unary_expression '=' assignment_expression

   73 expression: assignment_expression
   74           | expression ',' assignment_expression

   75 constant_expression: conditional_expression

   76 declaration: declaration_specifiers ';'
   77            | declaration_specifiers init_declarator_list ';'

   78 declaration_specifiers: storage_class_specifier declaration_specifiers
   79                       | storage_class_specifier
   80                       | type_specifier declaration_specifiers
   81                       | type_specifier

   82 init_declarator_list: init_declarator
   83                     | init_declarator_list ',' init_declarator

   84 init_declarator: declarator '=' initializer
   85                | declarator

   86 storage_class_specifier: EXTERN

   87 type_specifier: VOID
   88               | CHAR
   89               | SHORT
   90               | INT
   91               | LONG
   92               | FLOAT
   93               | DOUBLE
   94               | struct_or_union_specifier

   95 struct_or_union_specifier: STRUCT '{' struct_declaration_list '}'
   96                          | STRUCT IDENTIFIER '{' struct_declaration_list '}'
   97                          | STRUCT IDENTIFIER

   98 struct_declaration_list: struct_declaration
   99                        | struct_declaration_list struct_declaration

  100 struct_declaration: specifier_qualifier_list ';'
  101                   | specifier_qualifier_list struct_declarator_list ';'

  102 specifier_qualifier_list: type_specifier specifier_qualifier_list
  103                         | type_specifier

  104 struct_declarator_list: struct_declarator
  105                       | struct_declarator_list ',' struct_declarator

  106 struct_declarator: ':' constant_expression
  107                  | declarator ':' constant_expression
  108                  | declarator

  109 $@2: ε

  110 declarator: pointer direct_declarator $@2
  111           | direct_declarator

  112 direct_declarator: IDENTIFIER
  113                  | '(' declarator ')'
  114                  | direct_declarator '[' ']'
  115                  | direct_declarator '[' '*' ']'
  116                  | direct_declarator '[' assignment_expression ']'
  117                  | direct_declarator '(' parameter_type_list ')'
  118                  | direct_declarator '(' ')'
  119                  | direct_declarator '(' identifier_list ')'

  120 pointer: '*' pointer
  121        | '*'

  122 parameter_type_list: parameter_list

  123 parameter_list: parameter_declaration
  124               | parameter_list ',' parameter_declaration

  125 parameter_declaration: declaration_specifiers declarator
  126                      | declaration_specifiers abstract_declarator
  127                      | declaration_specifiers

  128 identifier_list: IDENTIFIER
  129                | identifier_list ',' IDENTIFIER

  130 type_name: specifier_qualifier_list abstract_declarator
  131          | specifier_qualifier_list

  132 abstract_declarator: pointer direct_abstract_declarator
  133                    | pointer
  134                    | direct_abstract_declarator

  135 direct_abstract_declarator: '(' abstract_declarator ')'
  136                           | '[' ']'
  137                           | '[' '*' ']'
  138                           | '[' assignment_expression ']'
  139                           | direct_abstract_declarator '[' ']'
  140                           | direct_abstract_declarator '[' '*' ']'
  141                           | direct_abstract_declarator '[' assignment_expression ']'
  142                           | '(' ')'
  143                           | '(' parameter_type_list ')'
  144                           | direct_abstract_declarator '(' ')'
  145                           | direct_abstract_declarator '(' parameter_type_list ')'

  146 initializer: '{' initializer_list '}'
  147            | '{' initializer_list ',' '}'
  148            | assignment_expression

  149 initializer_list: designation initializer
  150                 | initializer
  151                 | initializer_list ',' designation initializer
  152                 | initializer_list ',' initializer

  153 designation: designator_list '='

  154 designator_list: designator
  155                | designator_list designator

  156 designator: '[' constant_expression ']'
  157           | '.' IDENTIFIER

  158 statement: labeled_statement
  159          | compound_statement
  160          | expression_statement
  161          | selection_statement
  162          | iteration_statement
  163          | jump_statement

  164 labeled_statement: IDENTIFIER ':' statement
  165                  | CASE constant_expression ':' statement
  166                  | DEFAULT ':' statement

  167 compound_statement: '{' '}'
  168                   | '{' block_item_list '}'

  169 block_item_list: block_item
  170                | block_item_list block_item

  171 block_item: declaration
  172           | statement

  173 expression_statement: ';'
  174                     | expression ';'

  175 $@3: ε

  176 $@4: ε

  177 selection_statement: IF '(' expression ')' statement ELSE $@3 statement $@4
  178                    | if_without_else
  179                    | SWITCH '(' expression ')' statement

  180 if_without_else: IF '(' expression ')' statement

  181 iteration_statement: WHILE '(' expression ')' statement
  182                    | DO statement WHILE '(' expression ')' ';'
  183                    | FOR '(' expression_statement expression_statement ')' statement
  184                    | FOR '(' expression_statement expression_statement expression ')' statement
  185                    | FOR '(' declaration expression_statement ')' statement
  186                    | FOR '(' declaration expression_statement expression ')' statement

  187 jump_statement: CONTINUE ';'
  188               | BREAK ';'
  189               | RETURN ';'
  190               | RETURN expression ';'

  191 $@5: ε

  192 translation_unit: external_declaration $@5

  193 $@6: ε

  194 translation_unit: translation_unit external_declaration $@6

  195 $@7: ε

  196 external_declaration: function_definition $@7
  197                     | declaration

  198 function_definition: declaration_specifiers declarator declaration_list compound_statement
  199                    | declaration_specifiers declarator compound_statement

  200 declaration_list: declaration
  201                 | declaration_list declaration


